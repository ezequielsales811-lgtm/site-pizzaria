<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Pizzaria do Ezequiel</title>
<style>
  body { font-family: Arial; margin: 0; background: #fff8ee; text-align: center; }
  header { background: #c0392b; color: white; padding: 40px; }
  header h1 { font-size: 40px; margin: 0; }
  .card { background: white; width: 300px; margin: 20px auto; padding: 20px; border-radius: 15px; box-shadow: 0 0 10px #ccc; }
  .card img { width: 100%; border-radius: 10px; }
  .preco { color: #27ae60; font-size: 22px; font-weight: bold; }
  button { background: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 8px; cursor: pointer; font-size: 16px; }
  footer { background: #333; color: white; padding: 20px; margin-top: 30px; }
</style>
</head>
<body>

<header>
  <h1>🍕 Pizzaria do Ezequiel</h1>
  <p>A melhor de Nazaré da Mata - PE</p>
  <p>Entrega rápida | Aberto das 18h às 23h</p>
</header>

<div class="card">
  <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600">
  <h2>Calabresa</h2>
  <p>Molho de tomate, calabresa, cebola e queijo</p>
  <p class="preco">R$ 45,00</p>
  <button onclick="pedir('Calabresa')">Pedir Agora</button>
</div>

<div class="card">
  <img src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=600">
  <h2>Frango com Catupiry</h2>
  <p>Frango desfiado, catupiry original e milho</p>
  <p class="preco">R$ 50,00</p>
  <button onclick="pedir('Frango com Catupiry')">Pedir Agora</button>
</div>

<div class="card">
  <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=600">
  <h2>Marguerita</h2>
  <p>Molho, queijo, tomate e manjericão fresco</p>
  <p class="preco">R$ 42,00</p>
  <button onclick="pedir('Marguerita')">Pedir Agora</button>
</div>

<footer>
  <p>Feito por Ezequiel Sales - Desenvolvedor Júnior</p>
  <p>WhatsApp: (81) 99999-9999 - troca pelo teu número depois</p>
</footer>

<script>
  function pedir(sabor) {
    alert("Você escolheu Pizza de " + sabor + "! Pedido enviado!");
  }
</script>

</body>
</html>
